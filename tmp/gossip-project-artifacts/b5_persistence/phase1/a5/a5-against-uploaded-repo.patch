+
+#[inline]
+fn write_version_id_canonical(version: VersionId, h: &mut Hasher) {
+    match version {
+        VersionId::Strong(vid) => {
+            0u8.write_canonical(h);
+            vid.write_canonical(h);
+        }
+        VersionId::Weak(vid) => {
+            1u8.write_canonical(h);
+            vid.write_canonical(h);
+        }
+    }
