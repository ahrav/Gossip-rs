+/// Derive an [`OvidHash`] from stable item identity and version claim.
+#[inline]
+#[must_use]
+pub fn derive_ovid_hash(inputs: &OvidHashInputs) -> OvidHash {
+    let mut h = OVID_HASHER.clone();
+    inputs.write_canonical(&mut h);
