{
  "threshold": 6,
  "reporters": ["json", "consoleFull"],
  "ignore": [
    "target/**",
    "fuzz/**",
    "tmp/**",
    ".beads/**",
    "docs/**",
    "diagrams/**",
    "**/*test*",
    "**/*tests*",
    "**/benches/**"
  ],
  "minTokens": 50,
  "minLines": 5,
  "absolute": true,
  "skipLocal": false,
  "format": ["rust"]
}
